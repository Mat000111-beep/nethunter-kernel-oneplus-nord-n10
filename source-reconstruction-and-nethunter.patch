+static void mp2650_dump_reg_work(struct work_struct *work)
+{
+	int i = 0, rc = 0;
+	int reg_val = 0;
+
+	for (i = 0; i <= 0x48; i++) {
+		rc = mp2650_read_reg(i, &reg_val);
+		if (rc)
+			chg_err("read reg 0x%2x error rc=%d.", i, rc);
+		chg_err("reg 0x%02x value=0x%02x", i, reg_val);
+	}
+}
