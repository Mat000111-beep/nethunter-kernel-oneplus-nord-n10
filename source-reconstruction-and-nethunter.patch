index 0000000000000000000000000000000000000000..81c93f77de7a30392bebbc9387e0c176756b4527
--- /dev/null
+++ b/drivers/oneplus/power/OP_power_cut_test.c
@@ -0,0 +1,142 @@
+#include <linux/delay.h>
+#include <linux/err.h>
+#include <linux/init.h>
+#include <linux/kernel.h>
+
+#include <linux/io.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
