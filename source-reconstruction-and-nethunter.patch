+		TPD_INFO("Failed init register address\n");
+		return ret;
+	}
+	/* parse test limits from csv */
+	ret = goodix_init_testlimits(ts_test);
+	if (ret < 0) {
+		TPD_INFO("Failed to init testlimits from csv:%d\n", ret);
+		ts_test->error_count ++;
