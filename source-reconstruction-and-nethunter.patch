+static int bq2597x_detect_device(struct bq2597x *bq)
+{
+	int ret;
+	u8 data;
+
+	ret = bq2597x_read_byte(bq, BQ2597X_REG_13, &data);
+	bq_err("bq2597x:addr0x13=0x%02x.\n", data);
+	if (ret == 0) {
+		bq->part_no = (data & BQ2597X_DEV_ID_MASK);
+		bq->part_no >>= BQ2597X_DEV_ID_SHIFT;
+	}
+
+	return ret;
+}
