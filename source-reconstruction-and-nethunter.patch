+static int sec_get_face_detect(void * chip_data)
+{
+	int state = -1;
+	struct chip_data_s6sy761 *chip_info = (struct chip_data_s6sy761 *)chip_data;
+
+	if (chip_info->proximity_status == 0x2E) {
+		state = 0;		//far
+	} else if (chip_info->proximity_status == 0) {
+		state = 1;		//near
+	}
+	return state;
+}
