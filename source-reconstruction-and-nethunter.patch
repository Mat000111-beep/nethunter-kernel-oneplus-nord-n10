+	bq->irq_waiting = false;
+	/* TODO */
+	bq2597x_check_alarm_status(bq);
+	bq2597x_check_fault_status(bq);
+
+	bq2597x_dump_reg(bq);
+
+	mutex_unlock(&bq->irq_complete);
+}
