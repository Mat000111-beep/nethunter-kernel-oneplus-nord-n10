+    }
+    if(aw8697->trig[1].second_seq && aw8697->trig[1].dual_edge) {
+        aw8697_i2c_write(aw8697, AW8697_REG_TRG2_WAV_N, aw8697->trig[1].second_seq);
+    }
+    if(aw8697->trig[2].frist_seq) {
