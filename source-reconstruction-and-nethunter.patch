+static int pmic_set_icl_current(int chg_current)
+{
+	if (normal_charger != NULL) {
+		chg_err("set usb_icl vote to %d mA\n", chg_current);
+		vote(normal_charger->usb_icl_votable, WIRED_CONN_VOTER, true,
