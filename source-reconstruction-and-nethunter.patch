+static int ist8801_get_irq_state()
+{
+	if (g_ist8801_data == NULL) {
+		TRI_KEY_LOG("g_ist8801_data NULL \n");
+		return -EINVAL;
+	}
+
+	return ((g_ist8801_data->reg.map.intsrs & IST8801_DETECTION_MODE_INTERRUPT) ? 1 : 0);
+}
