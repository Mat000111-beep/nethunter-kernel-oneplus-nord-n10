+		default:
+			pr_err("wrong irq idx %d\n",
+				sde_irq->sde_irq_idx);
+			return -EINVAL;
+		}
+
+		pr_debug("idx:%d irq_idx:%d clr:0x%x en:0x%x status:0x%x\n",
+			idx, sde_irq->sde_irq_idx, sde_irq->clr_off,
+			sde_irq->en_off, sde_irq->status_off);
+	}
+
+	return 0;
+}
