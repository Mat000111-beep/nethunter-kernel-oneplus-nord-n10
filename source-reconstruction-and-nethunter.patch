+static short Sum(short value0, short value1)
+{
+    short sum = 0;
+	sum = value0 + value1;
+	return sum;
+}
+static short Minus(short value0, short value1)
+{
+	short minus = 0;
+	minus = value0 - value1;
+	return minus;
+}
