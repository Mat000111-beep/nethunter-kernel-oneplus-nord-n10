+	rc = p9415_read_reg(chip, 0x0040, val_buf, 2);
+	pr_debug("raw data:0x%02x, 0x%02x\n", val_buf[0], val_buf[1]);
+	if (rc) {
+		pr_err("read vrect err, rc=%d\n", rc);
+		return rc;
