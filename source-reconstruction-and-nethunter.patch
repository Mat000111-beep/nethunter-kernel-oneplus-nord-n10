+
+enum {
+	SDE_FRAME_LINEAR,
+	SDE_FRAME_TILE_A4X,
+	SDE_FRAME_TILE_A5X,
+};
+
+enum sde_hw_filter {
+	SDE_SCALE_FILTER_NEAREST = 0,
