+static bool mp2650_is_writeable_reg(struct device *dev, unsigned int reg)
+{
+	unsigned int addr;
+
+	addr = reg;
+	if ((addr >= 0x00 && addr <= 0x12)
+		|| (addr == 0x31) || (addr == 0x33)
+		|| (addr == 0x36))
+		return true;
+	return false;
+}
