+		u64 thresh_cnt[3];
+		struct longest_task_info *lt_info;
+};
+/* irq latency structure*/
+struct irq_latency_para {
+		int low_thresh;
+		int high_thresh;
+		u64 max;
+		u64 high_cnt;
+		u64 low_cnt;
+		u64 total;
+		u64 total_cnt;
+};
