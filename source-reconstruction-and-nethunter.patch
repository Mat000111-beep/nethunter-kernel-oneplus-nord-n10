+/**
+ * struct sde_crtc_mixer: stores the map for each virtual pipeline in the CRTC
+ * @hw_lm:	LM HW Driver context
+ * @hw_ctl:	CTL Path HW driver context
+ * @hw_dspp:	DSPP HW driver context
+ * @hw_ds:	DS HW driver context
