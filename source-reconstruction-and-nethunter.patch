+static int ist8801_clear_irq()
+{
+	if (g_ist8801_data == NULL) {
+		TRI_KEY_LOG("g_ist8801_data NULL \n");
+		return -EINVAL;
+	}
+
+	ist8801_clear_interrupt(g_ist8801_data);
+
+	return 0;
