+static void getSpecialCornerPoint(uint8_t *buf, int n, struct Coordinate *point)
+{
+	int x, y, i;
+
+	point[0].x = (buf[0] & 0xFF) | (buf[1] & 0x0F) << 8;
+	point[0].y = (buf[2] & 0xFF) | (buf[3] & 0x0F) << 8;
+	point[1] = point[0];
+	point[2] = point[0];
+	point[3] = point[0];
+	for (i = 0; i < n; i++) {
+		x = (buf[0 + 4 * i] & 0xFF) | (buf[1 + 4 * i] & 0x0F) << 8;
+		y = (buf[2 + 4 * i] & 0xFF) | (buf[3 + 4 * i] & 0x0F) << 8;
+		if (point[3].x < x) {   //xmax
+			point[3].x = x;
+			point[3].y = y;
+		}
+		if (point[1].x > x) {   //xmin
+			point[1].x = x;
+			point[1].y = y;
+		}
+		if (point[2].y < y) {   //ymax
+			point[2].y = y;
+			point[2].x = x;
+		}
+		if (point[0].y > y) {   //ymin
+			point[0].y = y;
+			point[0].x = x;
+		}
+	}
+}
