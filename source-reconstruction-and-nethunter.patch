+int sec_execute_force_calibration(struct chip_data_s6sy761 *chip_info)
+{
+	int rc = -1;
+
+	if (touch_i2c_write_block(chip_info->client, SEC_CMD_FACTORY_PANELCALIBRATION, 0, NULL) < 0) {
+		TPD_INFO("%s: Write Cal commend failed!\n", __func__);
