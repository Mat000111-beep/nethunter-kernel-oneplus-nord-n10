+static int setup_tunings(struct stmvl53l1_data *data)
+{
+	int rc = 0;
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(tunings); i++) {
+		rc = VL53L1_SetTuningParameter(&data->stdev, tunings[i][0],
+			tunings[i][1]);
