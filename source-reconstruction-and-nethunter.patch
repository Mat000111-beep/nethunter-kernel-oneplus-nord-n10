+		cc_cnt = atomic64_read(&cc_stat.cnt[i]);
+		cc_tcnt = atomic64_read(&cc_stat.tcnt[i]) + cc_cnt;
+		atomic64_set(&cc_stat.cnt[i], 0);
+		atomic64_set(&cc_stat.tcnt[i], cc_tcnt);
