+/****************************PART1:Log TAG****************************/
+#define TPD_DEVICE "Goodix-TOOL"
+#define TPD_INFO(fmt, arg...)        pr_err(TPD_DEVICE ": " fmt, ##arg)
+#define TPD_DEBUG(fmt, arg...)       do{\
+    if (tp_debug)\
+    pr_err(TPD_DEVICE ": " fmt, ##arg);\
+}while(0)
+
+#define TPD_DEBUG_ARRAY(array, num)    do{\
