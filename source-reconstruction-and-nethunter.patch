+		if(i % 10 == 9)
+			seq_printf(s, "\n");
+	}
+	seq_printf(s, "\n");
+
+	seq_printf(s, "==== Goodix config read from chip====\n");
+
+	if (!chip_info->reg_info.GTP_REG_CMD) {
+		TPD_INFO("command register ERROR:0x%04x", chip_info->reg_info.GTP_REG_CMD);
