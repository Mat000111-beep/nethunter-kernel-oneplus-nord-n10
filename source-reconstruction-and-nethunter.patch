+		pr_err("smbchg not ready\n");
+		return;
+	}
+
+	if (!g_p9415_chip) {
+		pr_err(" p9415_chip is NULL\n");
+	} else {
+		schedule_delayed_work(&g_p9415_chip->idt_connect_int_work, 0);
+	}
