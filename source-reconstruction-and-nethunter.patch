+/*
+*
+*
+*/
+static void copy_one_line (char *copy_from,char *copy_to)
+{
+// 	TPD_INFO("%s --enter",__func__);
+
+	do {
+		*copy_to = *copy_from;
+		copy_to ++;
+		copy_from++;
+	}
+	while ( (*copy_from  != '\n') && ( *copy_from != '\t') && ( *copy_from != '\0'));
+	*copy_to = '\n';
+  }
