+	msm_property_install_range(&sde_crtc->property_info,
+		"idle_time", 0, 0, U64_MAX, 0,
+		CRTC_PROP_IDLE_TIMEOUT);
+
+    msm_property_install_range(&sde_crtc->property_info,
+	"CRTC_CUST",0x0, 0, INT_MAX, 0,CRTC_PROP_CUSTOM);
+	if (catalog->has_idle_pc)
