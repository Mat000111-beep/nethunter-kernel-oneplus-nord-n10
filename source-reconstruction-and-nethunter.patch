+	pdata->gph__range_config__timeout_macrop_b_lo =
+		(*(pbuffer +   9));
+	pdata->gph__range_config__sigma_thresh =
+		(VL53L1_i2c_decode_uint16_t(2, pbuffer +  10));
+	pdata->gph__range_config__min_count_rate_rtn_limit_mcps =
