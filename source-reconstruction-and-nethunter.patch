+static void store_to_file(int fd, char *format, ...)
+{
+	va_list args;
+	char buf[64] = {0};
+
+	va_start(args, format);
+	vsnprintf(buf, 64, format, args);
+	va_end(args);
+
+	if(fd >= 0) {
+		ksys_write(fd, buf, strlen(buf));
+	}
+}
