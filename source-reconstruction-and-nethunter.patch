+#define CC_TIME_END(start, end, t, tmax) { \
+	if (cc_time_measure) { \
+		end = ktime_get(); \
+		t = ktime_to_us(ktime_sub(end, begin)); \
+		if (t > tmax) \
+			tmax = t; \
