+static irqreturn_t ist8801_down_irq_handler(int irq, void *dev_id)
+{
+	TRI_KEY_LOG("call \n");
+
+	if (!g_ist8801_data) {
+		TRI_KEY_LOG("g_ist8801_data NULL \n");
