+
+	chip_info->fw_id = data[0] << 24 | data[1] << 16 | data[2] << 8 | data[3];
+	TPD_INFO("%s : data[0] = 0x%2.2X, data[1] = 0x%2.2X, data[2] = 0x%2.2X, data[3] = 0x%2.2X\n",
+					__func__, data[0], data[1], data[2], data[3]);
