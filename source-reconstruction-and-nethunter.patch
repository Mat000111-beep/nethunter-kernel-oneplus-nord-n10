+    INIT_DELAYED_WORK(&aw8697->ram_work, aw8697_ram_work_routine);
+    schedule_delayed_work(&aw8697->ram_work, msecs_to_jiffies(ram_timer_val));
+#else
+    aw8697_ram_update(aw8697);
+#endif
+    return 0;
+}
