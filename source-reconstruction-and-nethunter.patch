+static int sde_kms_pd_disable(struct generic_pm_domain *genpd)
+{
+	struct sde_kms *sde_kms = genpd_to_sde_kms(genpd);
+
+	SDE_DEBUG("\n");
+
+	pm_runtime_put_sync(sde_kms->dev->dev);
+
+	SDE_EVT32(genpd->device_count);
+
+	return 0;
+}
