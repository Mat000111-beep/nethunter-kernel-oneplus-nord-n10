+{
+	int ret = 0;
+	struct chip_data_brl *chip_info = (struct chip_data_brl *)ts_test->ts;
+
+	TPD_INFO("TP test preparation\n");
+	ret = goodix_cache_origconfig(ts_test);
+	if (ret) {
