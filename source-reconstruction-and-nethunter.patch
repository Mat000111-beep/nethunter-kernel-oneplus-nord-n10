+void diag_parse_raw_data(struct himax_report_data *hx_touch_data, int mul_num,
+				int self_num, uint8_t diag_cmd, int32_t *mutual_data, int32_t *self_data)
+{
+	int RawDataLen_word;
+	int index = 0;
+	int temp1, temp2, i;
+
+	if (hx_touch_data->hx_rawdata_buf[0] == 0x3A
+		&& hx_touch_data->hx_rawdata_buf[1] == 0xA3
+		&& hx_touch_data->hx_rawdata_buf[2] > 0
+		&& hx_touch_data->hx_rawdata_buf[3] == diag_cmd) {
+		RawDataLen_word = hx_touch_data->rawdata_size / 2;
+		index = (hx_touch_data->hx_rawdata_buf[2] - 1) * RawDataLen_word;
+		for (i = 0; i < RawDataLen_word; i++) {
+			temp1 = index + i;
+
+			if (temp1 < mul_num) {
+				//mutual
+				mutual_data[index + i] =
+					((int8_t)hx_touch_data->hx_rawdata_buf[i * 2 + 4 + 1]) * 256 +
+				hx_touch_data->hx_rawdata_buf[i * 2 + 4]; /* 4: RawData Header, 1:HSB  */
+			} else {
+				//self
+				temp1 = i + index;
+				temp2 = self_num + mul_num;
+
+				if (temp1 >= temp2)
+					break;
+
+				self_data[i + index - mul_num] =
+					(((int8_t)hx_touch_data->hx_rawdata_buf[i * 2 + 4 + 1]) << 8) |
+				hx_touch_data->hx_rawdata_buf[i * 2 + 4]; /* 4: RawData Header */
+				//self_data[i+index-mul_num+1] = hx_touch_data->hx_rawdata_buf[i*2 + 4 + 1];
+			}
+		}
+	}
+
+}
