+char *goto_next_line (char *buf)
+{
+	//int j = 0;
+
+// 	TPD_INFO("%s --enter",__func__);
+	if (!buf) {
+		TPD_INFO("%s:the buf is null",__func__);
+		return 0;
+	}
+
+	do {
+		buf =buf +1;
+		//TPD_INFO ("J value is :%d\n", j++);
+		}
+	while ((*buf !=  '\n') &&  (*buf != '\0'));
+	if(*buf == '\0')
+	return buf;
+	buf = buf +1 ;
+	return buf;
+   }
