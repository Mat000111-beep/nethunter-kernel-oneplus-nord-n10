+
+#define ohm_err(fmt, ...) \
+	printk(KERN_ERR "[OHM_ERR][%s]"fmt, __func__, ##__VA_ARGS__)
+#define ohm_debug(fmt, ...) \
+	printk(KERN_INFO "[OHM_INFO][%s]"fmt, __func__, ##__VA_ARGS__)
