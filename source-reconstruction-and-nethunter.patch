+static int ist8801_get_id(ist8801_data_t *ist8801_data)
+{
+	u8 data = 0;
+	ist8801_i2c_read_block(ist8801_data,IST8801_REG_DID,&data,1);
+
+	TRI_KEY_LOG("id = 0x%x \n",data);
+
+	return data;
+}
