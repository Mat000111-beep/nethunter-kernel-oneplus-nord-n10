+uint32_t VL53L1_calc_pll_period_us(
+	uint16_t  fast_osc_frequency)
+{
+
+
+
+
+
+
+
+
+
+
+
+
+
+
+	uint32_t  pll_period_us        = 0;
+
+	LOG_FUNCTION_START("");
+
+	pll_period_us = (0x01 << 30) / fast_osc_frequency;
+
+
+
+
+
+
+
+	LOG_FUNCTION_END(0);
+
+	return pll_period_us;
+}
