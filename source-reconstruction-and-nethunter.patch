+static bool dp_catalog_panel_dhdr_busy(struct dp_catalog_panel *panel)
+{
+	struct dp_catalog_private *catalog;
+	struct dp_io_data *io_data;
+	u32 dp_flush, offset;
+
+	if (panel->stream_id >= DP_STREAM_MAX) {
