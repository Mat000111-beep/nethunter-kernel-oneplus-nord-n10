+
+	if (length < TOUCH_REPORT_CONFIG_SIZE) {
+		TPD_INFO("Invalid maximum touch report config size\n");
+		return -EINVAL;
+	}
+
+	LOCK_BUFFER(touch_hcd->out);
+
+	retval = syna_tcm_alloc_mem(&touch_hcd->out, length);
