+		MDSS_PLL_REG_W(phy_base, HDMI_PHY_TXCAL_CFG3, 0x05);
+		udelay(200);
+		break;
+
+	case 1342500000:
+		MDSS_PLL_REG_W(phy_base, HDMI_PHY_GLB_CFG, 0x81);
+		MDSS_PLL_REG_W(pll_base, HDMI_UNI_PLL_GLB_CFG, 0x01);
+		MDSS_PLL_REG_W(pll_base, HDMI_UNI_PLL_REFCLK_CFG, 0x01);
