+void VL53L1_print_nvm_raw_data(
+	uint8_t                       *pnvm_raw_data,
+	uint32_t                       trace_flags)
+{
+
+
+
+
+
+	int i = 0;
+
+	LOG_FUNCTION_START("");
+
+	for (i = 0 ; i < VL53L1_NVM_SIZE_IN_BYTES ; i++) {
+		if (i % 4 == 0)
+			trace_print(
+				VL53L1_TRACE_LEVEL_INFO,
+				"\n    NVM Addr 0x%02X : 0x",
+				i/4);
+
+		trace_print(
+			VL53L1_TRACE_LEVEL_INFO,
+			"%02X",
+			*pnvm_raw_data++);
+	}
+
+	trace_print(
+		VL53L1_TRACE_LEVEL_INFO,
+		"\n");
+
+	LOG_FUNCTION_END(0);
