+	do { \
+		SDEROT_DBG("SDEREG.D:[%s:0x%X] <= 0x%X\n", #off, (off)\
+				, (u32)(data));\
+		writel_relaxed(data, (base + (off))); \
+	} while (0)
+
+#define SDE_ROTREG_READ(base, off) \
+	readl_relaxed(base + (off))
