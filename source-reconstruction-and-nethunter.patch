+		if (!ctrl->ctrl || (ctrl == m_ctrl))
+			continue;
+
+		rc = dsi_ctrl_setup(ctrl->ctrl);
+		if (rc) {
+			DSI_ERR("DSI controller setup failed\n");
+			return rc;
+		}
+	}
+	return 0;
+}
