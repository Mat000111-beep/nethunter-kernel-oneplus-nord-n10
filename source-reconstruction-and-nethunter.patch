+	/* wait for config data ready */
+	if (goodix_wait_cfg_cmd_ready(chip_info, COMMAND_READ_CFG_PREPARE_OK, COMMAND_START_READ_CFG)) {
+		TPD_INFO("Wait for config data ready timeout");
