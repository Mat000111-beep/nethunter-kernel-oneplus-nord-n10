+			phistogram,
+			pgeneral,
+			ptiming,
+			pdynamic,
+			psystem,
+			ptuning_parms,
+			pzone_cfg);
+
+
+
+
+	if (status == VL53L1_ERROR_NONE) {
+
+
+
+
+		phistogram->histogram_config__spad_array_selection = 0x01;
