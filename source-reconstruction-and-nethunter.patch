+static void hx83112f_tp_shutdown(struct spi_device *spi)
+{
+	int rc;
+	int i = 100;
+	struct touchpanel_data *ts = spi_get_drvdata(spi);
+
+	TPD_INFO("%s is called\n", __func__);
+
+	tp_shutdown(ts->dev);
+
+	//if (ts->int_mode == BANNABLE) {
+	disable_irq_wake(ts->irq);
+	//}
+	disable_irq_nosync(ts->irq);
+
+	free_irq(ts->irq, ts);
+
+	/*
+	if(TP_Panel != NULL){
+		gpio_set_value(TP_Panel->reset_config.reset_gpio, 0);
+		usleep_range(10000, 12000);
+		rc = dsi_pwr_enable_regulator(&TP_Panel->power_info, false);
+		if (rc)
+			TPD_INFO("failed to enable vregs, rc=%d\n", rc);
+	}
+	*/
+	if(TP_Panel != NULL){
+		gpio_set_value(TP_Panel->reset_config.reset_gpio, 0);
+	}
+	mdelay(5);
+	gpio_direction_output(ts->hw_res.reset_gpio, 0);
+	mdelay(5);
+	gpio_direction_output(ts->hw_res.cs_gpio, 0);
+	while(gpio_get_value(ts->hw_res.cs_gpio) != 0&&(i>0)){
+		usleep_range(10000, 10200);
+		i--;
+	}
+
+	mdelay(20);
+
+	if(TP_Panel != NULL){
+		usleep_range(10000, 12000);
+		rc = dsi_pwr_enable_regulator(&TP_Panel->power_info, false);
+		if (rc)
+			TPD_INFO("failed to enable vregs, rc=%d\n", rc);
+	}
+
+	TPD_INFO("%s is called cs is below\n", __func__);
+	return ;
+}
