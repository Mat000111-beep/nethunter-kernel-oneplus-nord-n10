+	},
+	.probe		= wlchg_rx_probe,
+	.remove		= wlchg_rx_remove,
+	.shutdown	= wlchg_rx_reset,
+	.id_table	= wlchg_rx_id,
+};
+
+module_i2c_driver(wlchg_rx_driver);
+
+MODULE_LICENSE("GPL v2");
