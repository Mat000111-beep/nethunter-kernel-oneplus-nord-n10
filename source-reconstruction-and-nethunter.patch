+
+		memcpy(tcm_info->config.buf, tcm_info->default_config.buf, length);
+		tcm_info->config.buf_size = tcm_info->default_config.buf_size;
+		tcm_info->config.data_length = tcm_info->default_config.data_length;
+	}
