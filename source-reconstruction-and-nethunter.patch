+		cmd_flag = 0;
+		ret = gt9886_i2c_read(chip_info->client, cmd_reg, 1, &cmd_flag);
+		if (ret < 0 || cmd_flag == TS_CMD_REG_READY)
+			break;
+		usleep_range(10000, 11000);
+	}
