+static int syna_set_gesture_report_config(struct syna_tcm_data *tcm_info)
+{
+	int retval;
+	unsigned int idx = 0;
+	unsigned int length;
+	struct touch_hcd *touch_hcd = tcm_info->touch_hcd;
+
+	TPD_DEBUG("%s: set gesture report\n", __func__);
