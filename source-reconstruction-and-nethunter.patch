+void himax_in_parse_assign_cmd(uint32_t addr, uint8_t *cmd, int len)
+{
+	switch (len) {
+	case 1:
+		cmd[0] = addr;
+		break;
+	case 2:
+		cmd[0] = addr % 0x100;
+		cmd[1] = (addr >> 8) % 0x100;
+		break;
+	case 4:
+		cmd[0] = addr % 0x100;
+		cmd[1] = (addr >> 8) % 0x100;
+		cmd[2] = (addr >> 16) % 0x100;
+		cmd[3] = addr / 0x1000000;
+		break;
+	default:
+		TPD_INFO("%s: input length fault, len = %d!\n", __func__, len);
+	}
+}
