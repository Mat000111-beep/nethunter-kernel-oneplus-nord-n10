+static int ctrl_param_optical_center(struct stmvl53l1_data *data,
+		struct stmvl53l1_parameter *param)
+{
+	if (!param->is_read)
+		return -EINVAL;
+
+	param->value = data->optical_offset_x;
+	param->value2 = data->optical_offset_y;
+
