+#define GTP_ADDR_LENGTH     2
+#define DATA_LENGTH         (DATA_LENGTH_UINT - GTP_ADDR_LENGTH)
+#define CMD_HEAD_LENGTH     (sizeof(struct st_cmd_head) - sizeof(u8*))
+
+#endif
