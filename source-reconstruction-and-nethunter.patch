+}
+
+static inline int dp_pll_clock_register_10nm(struct platform_device *pdev,
+				struct mdss_pll_resources *pll_res)
+{
+	return 0;
+}
+
+static inline int dp_pll_clock_register_7nm(struct platform_device *pdev,
+				struct mdss_pll_resources *pll_res)
