+	if (ts->black_gesture_support) {
+		if (ts->gesture_enable == 1) {
+			/*disable gpio wake system through intterrupt*/
+			disable_irq_wake(ts->irq);
+			goto out;
+		}
+	}
+	if (ts->int_mode == BANNABLE) {
+		enable_irq(ts->irq);
+	}
+out:
+	ts->i2c_ready = true;
