+static int goodix_get_vendor(void *chip_data, struct panel_info *panel_data)
+{
+	int len = 0;
+	char manu_temp[MAX_DEVICE_MANU_LENGTH] = "HD_";
+	struct chip_data_gt9886 *chip_info = (struct chip_data_gt9886 *)chip_data;
