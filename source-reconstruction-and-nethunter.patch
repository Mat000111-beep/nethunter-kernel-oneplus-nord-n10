+static int p9415_get_cep_change_status(struct op_p9415_ic *chip)
+{
+	char val_buf[2] = { 0, 0 };
+	static int pre_val;
+	int val;
+	int rc;
+
+	rc = p9415_read_reg(chip, 0x0020, val_buf, 2);
+	if (rc) {
+		pr_err("Couldn't read cep change status, rc=%d\n", rc);
+		return rc;
+	}
+	val = val_buf[0] | val_buf[1] << 8;
+
+	if (val != pre_val) {
+		pre_val = val;
+		return 0;
+	} else {
+		return -EINVAL;
+	}
+}
