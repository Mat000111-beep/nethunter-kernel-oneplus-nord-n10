+		{137730000, 0x3F},
+		{147310000, 0x2F},
+		{275450000, 0x3F},
+		{294620000, 0x2F},
+		{344650000, 0x3F},
+		{363800000, 0x2F},
+		{477960000, 0x3F},
+		{512530000, 0x2F},
+		{550890000, 0x1F},
+		{589240000, 0x2F},
+		{630900000, 0x3F},
+		{650590000, 0x2F},
+		{689290000, 0x1F},
+		{727600000, 0x2F},
+		{HDMI_PLL_TMDS_MAX, 0x3F},
+	},
+	.ip_setp = (struct hdmi_pll_cfg[]){
+		{497340000, 0x03},
+		{512530000, 0x07},
+		{535680000, 0x03},
+		{550890000, 0x07},
+		{574060000, 0x03},
+		{727600000, 0x07},
+		{HDMI_PLL_TMDS_MAX, 0x03},
+	},
+	.cp_setp = (struct hdmi_pll_cfg[]){
