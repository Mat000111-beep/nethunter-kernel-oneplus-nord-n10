+static void syna_tcm_fingerprint_info(void *chip_data, struct fp_underscreen_info *fp_tpinfo)
+{
+	struct syna_tcm_data *tcm_info = (struct syna_tcm_data *)chip_data;
+	struct touch_hcd *touch_hcd = tcm_info->touch_hcd;
