+    aw8697_interrupt_clear(aw8697);
+    aw8697_i2c_write_bits(aw8697, AW8697_REG_SYSINTM,
+            AW8697_BIT_SYSINTM_UVLO_MASK, AW8697_BIT_SYSINTM_UVLO_EN);
+    return 0;
+}
