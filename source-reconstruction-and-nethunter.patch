+#endif
+};
+
+static struct i2c_driver tp_i2c_driver = {
+	.probe = goodix_tp_probe,
+	.remove = goodix_tp_remove,
+	.id_table = tp_id,
+	.driver = {
+		.name = TPD_DEVICE,
+		.owner = THIS_MODULE,
+		.of_match_table = tp_match_table,
+		.pm = &tp_pm_ops,
+	},
+};
+/******************* End of I2C Driver and It's dev_pm_ops***********************/
