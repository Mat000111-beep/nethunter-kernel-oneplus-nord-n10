+	int (*set_colorspace)(struct drm_connector *connector,
+			void *display);
+
+	/**
+	 * soft_reset - perform a soft reset on the connector
+	 * @display: Pointer to private display structure
+	 * Return: Zero on success, -ERROR otherwise
