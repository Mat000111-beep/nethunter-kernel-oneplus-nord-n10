+		err |= m1120_i2c_write_block(p_m1120_data, M1120_REG_LTHL,&lthl, 1);
+	}
+
+	if (err < 0) {
+		TRI_KEY_ERR("tri_key:fail %d\n",err);
+		return false;
+	} else {
+		return true;
+	}
+
+    return true;  
+}
