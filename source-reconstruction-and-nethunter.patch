+		cb_set.memplus_move_swapcache_to_anon_lru_cb(page);
+	else
+		clear_bit(PG_swapcache, &(PF_NO_TAIL(page, 1))->flags);
+}
+void memplus_move_anon_to_swapcache_lru(struct page *page)
