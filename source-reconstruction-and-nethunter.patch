+static inline void ht_dump_parcel(struct ai_parcel *p)
+{
+	ht_logv("%s: dump pid %u fps %u volt %llu current %llu skin %lu\n",
+		__func__, p->pid, p->fps, p->volt_now, p->curr_now, p->skin_temp);
+}
