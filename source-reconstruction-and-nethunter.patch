+uint16_t VL53L1_calc_range_ignore_threshold(
+	uint32_t central_rate,
+	int16_t  x_gradient,
+	int16_t  y_gradient,
+	uint8_t  rate_mult)
+{
+
+
+
+
+
+
+
+
+
+
+
+
+
+
