+	.set_prop = p9415_set_prop,
+	.send_msg = p9415_send_msg,
+	.send_match_q_parm = p9415_send_match_q_parm,
+	.set_fod_parm = p9415_set_fod_parm,
+	.rx_reset = p9415_reset,
+};
