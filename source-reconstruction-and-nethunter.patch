+static int hx83112f_enable_charge_mode(struct chip_data_hx83112f *chip_info, bool enable)
+{
+	int ret = 0;
+	uint8_t tmp_addr[4];
+	uint8_t tmp_data[4];
+
+	TPD_INFO("%s, charge mode enable = %d\n", __func__, enable);
+	/*Enable:0x10007F38 = 0xA55AA55A  */
+	if (enable) {
+		tmp_addr[3] = 0x10;
+		tmp_addr[2] = 0x00;
+		tmp_addr[1] = 0x7F;
+		tmp_addr[0] = 0x38;
+		tmp_data[3] = 0xA5;
+		tmp_data[2] = 0x5A;
+		tmp_data[1] = 0xA5;
+		tmp_data[0] = 0x5A;
+		himax_flash_write_burst(tmp_addr, tmp_data);
+	} else {
+		tmp_addr[3] = 0x10;
+		tmp_addr[2] = 0x00;
+		tmp_addr[1] = 0x7F;
+		tmp_addr[0] = 0x38;
+		tmp_data[3] = 0x77;
+		tmp_data[2] = 0x88;
+		tmp_data[1] = 0x77;
+		tmp_data[0] = 0x88;
+		himax_flash_write_burst(tmp_addr, tmp_data);
+	}
+
+	return ret;
+}
