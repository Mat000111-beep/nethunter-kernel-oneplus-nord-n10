+static int sde_kms_pd_enable(struct generic_pm_domain *genpd)
+{
+	struct sde_kms *sde_kms = genpd_to_sde_kms(genpd);
+	int rc = -EINVAL;
+
+	SDE_DEBUG("\n");
+
+	rc = pm_runtime_get_sync(sde_kms->dev->dev);
+	if (rc > 0)
+		rc = 0;
+
+	SDE_EVT32(rc, genpd->device_count);
+
+	return rc;
+}
