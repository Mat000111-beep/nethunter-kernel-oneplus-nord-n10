+
+	pr_err("%s: input data = %s,  write_mp2650_data = 0x%02X\n", __func__, write_data, critical_log);
+
+	rc = mp2650_config_interface(mp2650_add, critical_log, 0xff);
+	if (rc) {
+		 chg_err("Couldn't write 0x%02X rc = %d\n", mp2650_add, rc);
+	}
+
+	return len;
+}
