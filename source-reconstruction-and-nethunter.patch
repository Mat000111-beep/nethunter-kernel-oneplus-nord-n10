+static int m1120_get_data( short *data)
+{ 
+    int err = 0;
+	u8 buf[3] = {0};
+	short value = 0;
+
+    TRI_KEY_DEBUG(KERN_INFO "======> %s", __func__);
+    if(!p_m1120_data) {
