+	.attr = {
+		.name = "calibration_data",
+		.mode = 0660/*S_IWUGO | S_IRUGO*/,
+	},
+	.size = sizeof(VL53L1_CalibrationData_t),
+	.read = stmvl53l1_calib_data_read,
+	.write = stmvl53l1_calib_data_write,
+};
