+++ b/drivers/platform/msm/gsi/gsi.c
@@ -2739,7 +2739,23 @@ int gsi_write_channel_scratch(unsigned long chan_hdl,
 
 	return GSI_STATUS_SUCCESS;
 }
-EXPORT_SYMBOL(gsi_write_channel_scratch);
+/*
+ * genksyms in this 4.19 tree cannot describe the packed union passed by
+ * value here, leaving a weak __crc symbol that modern linkers reject.  Keep
+ * the ABI and export name intact, but intentionally omit only this unusable
+ * CRC entry.  The original build already reports this symbol as unversioned.
+ */
+#ifndef __GENKSYMS__
+#define EXPORT_SYMBOL_NOVERS(sym)                                     \
+	extern typeof(sym) sym;                                        \
+	static const char __kstrtab_##sym[]                            \
+	__attribute__((section("__ksymtab_strings"), used, aligned(1))) \
+	= #sym;                                                        \
+	__KSYMTAB_ENTRY(sym, "")
+#else
+#define EXPORT_SYMBOL_NOVERS(sym)
+#endif
+EXPORT_SYMBOL_NOVERS(gsi_write_channel_scratch);
 
 int gsi_read_channel_scratch(unsigned long chan_hdl,
 		union __packed gsi_channel_scratch *val)
