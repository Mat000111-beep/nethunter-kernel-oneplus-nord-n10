+	if (buf_size < VL53L1_GENERAL_CONFIG_I2C_SIZE_BYTES)
+		return VL53L1_ERROR_COMMS_BUFFER_TOO_SMALL;
+
+	pdata->gph_config__stream_count_update_value =
+		(*(pbuffer +   0));
