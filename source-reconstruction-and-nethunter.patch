+			     struct dsi_mode_info *timing);
+
+/**
+ * dsi_ctrl_update_host_config() - update dsi host configuration
+ * @dsi_ctrl:          DSI controller handle.
+ * @config:            DSI host configuration.
+ * @mode:              DSI host mode selected.
