+
+enum mdss_mdp_intr_type {
+	SDE_MDP_IRQ_WB_ROT_COMP = 0,
+	SDE_MDP_IRQ_WB_WFD = 4,
+	SDE_MDP_IRQ_PING_PONG_COMP = 8,
+	SDE_MDP_IRQ_PING_PONG_RD_PTR = 12,
+	SDE_MDP_IRQ_PING_PONG_WR_PTR = 16,
